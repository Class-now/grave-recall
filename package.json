{
  "name": "grave-recall",
  "version": "0.1.0",
  "private": true,
  "description": "Spaced-repetition vocabulary app where every word lives as a grave in a procedurally generated graveyard.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@preact/signals": "2.0.3",
    "preact": "10.25.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.4",
    "@testing-library/user-event": "14.5.2",
    "@vitest/coverage-v8": "2.1.9",
    "fast-check": "3.23.2",
    "jsdom": "25.0.1",
    "typescript": "5.7.3",
    "vite": "6.0.11",
    "vitest": "2.1.9"
  }
}
